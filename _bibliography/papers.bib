@article{duttaJEMT,
  abbr={JEMT},
  bibtex_show={true},
  title={Influence of Shear Stiffness on Static and Dynamic Performance of Auxetic Metamaterials (Under Review)},
  author={Turna N R, Dutta S, Luong T, Aaleti S and Patiballa S K},
  journal={Journal of Engineering Materials and Technology},
  publisher = {ASME},
  abstract = {Auxetic mechanical metamaterials exhibit a negative Poisson's ratio, i.e., they contract laterally under longitudinal compression, which densifies the structure and enables superior energy absorption and impact resistance. This counterintuitive behavior is coupled to shear stiffness. However, the influence of shear stiffness in auxetics remains incompletely understood, owing to the highly nonlinear, geometry- and rate-dependent nature of shear. In this study, we address this by comparing two metamaterial geometries with varying shear stiffness: negative Poisson's ratio low shear (NLS) and negative Poisson's ratio high shear (NHS) lattices. The unit cell geometries were constructed via load flow-based design framework, and their bulk properties were computed using visco-hyperelastic finite element analysis (FEA) models. The structures were then characterized experimentally under quasi-static compression, cyclic compression, and drop-weight impact. Under quasi-static compression, the NHS lattice exhibited a 32.0% higher load-bearing capacity than the NLS lattice, and under cyclic loading, it dissipated 20.5% more energy. This behavior reversed under dynamic impact, where the NLS lattice absorbed 53.6% more energy than the NHS counterpart. Finite element models were developed and validated against experiments with average relative errors of 5.0\% for quasi-static compression and 11.0\% for drop-weight impact across all configurations. The results show that auxetic metamaterial lattices with different shear stiffness exhibit significant differences in static and dynamic performance. This research highlights the importance of shear stiffness in auxetic metamaterials for applications in protective barriers and debris-resistant structures.},
  volume={},
  number={},
  pages={},
  year={2026},
  doi={},
  selected    = {false},
  altmetric   = {false},
  bibtex_show = {false},
  dimensions  = {false}
}

